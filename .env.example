APP_URL=http://localhost/paleco-hub
APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paleco_hub
DB_USERNAME=root
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/paleco-hub/auth/google/callback
