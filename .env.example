APP_URL=http://localhost/paleco-hub
APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paleco_hub
DB_USERNAME=root
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/paleco-hub/auth/google/callback
MAX_POSTERS=10
# Existing provider: Google Cloud Vision (requires an approved API/billing setup).
# Set google_vision only after setup; Google Sign-In credentials do not enable OCR.
# See docs/ocr-setup.md and run php bin/check-ocr.php.
OCR_PROVIDER=none
# Conservative application-wide units per Asia/Manila calendar month; 0 disables new requests.
OCR_MONTHLY_LIMIT=900
# Example: GOOGLE_APPLICATION_CREDENTIALS=C:/xampp/private/paleco-vision-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
# theme: first poster is displayed by the WordPress template; content: template hides featured image.
SCHEDULED_FEATURED_DISPLAY=theme
