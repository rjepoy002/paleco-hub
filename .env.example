# Set google_vision only after enabling Vision and providing a private service-account JSON file.
OCR_PROVIDER=none
GOOGLE_APPLICATION_CREDENTIALS=
# theme: first poster is displayed by the WordPress template; content: template hides featured image.
SCHEDULED_FEATURED_DISPLAY=theme
